# Copier ce fichier en .env et renseigner des valeurs reelles.
# En CI, .env est genere a la volee (openssl rand -hex 24) : ne jamais committer .env.

# --- Serveur Minecraft (RCON) ---
RCON_PASSWORD=change_me_rcon

# --- Sauvegardes restic ---
RESTIC_PASSWORD=change_me_restic

# Depot restic de production (Backblaze B2). Format attendu : b2:<bucket>:<chemin>
# Laisser vide en local/CI : docker-compose.ci.yml force un depot local a la place.
RESTIC_REPOSITORY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
